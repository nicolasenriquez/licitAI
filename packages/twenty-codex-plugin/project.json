{
  "name": "twenty-codex-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-codex-plugin",
  "projectType": "library",
  "tags": ["scope:codex-plugin"],
  "targets": {
    "validate": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ./scripts/validate.js --repo-root ../.."
      },
      "inputs": [
        "{projectRoot}/.codex-plugin/**/*",
        "{projectRoot}/.mcp.json",
        "{projectRoot}/assets/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/references/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/skills/**/*",
        "{projectRoot}/templates/**/*",
        "{workspaceRoot}/packages/twenty-ui/.storybook/**/*",
        "{workspaceRoot}/packages/twenty-ui/src/**/*.stories.*",
        "{workspaceRoot}/packages/twenty-front/.storybook/**/*",
        "{workspaceRoot}/packages/twenty-front/src/**/*.stories.*",
        "{workspaceRoot}/packages/twenty-design-tokens/src/source/**/*",
        "{workspaceRoot}/docs/design/storybook-ui-source-of-truth.md",
        "{workspaceRoot}/docs/README.md"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --test ./scripts/__tests__/*.spec.js"
      },
      "inputs": ["{projectRoot}/scripts/**/*"]
    },
    "setup:mcp": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash ./scripts/setup-mcp.sh"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx oxfmt --check ."
      },
      "configurations": {
        "ci": {},
        "fix": {
          "command": "npx oxfmt ."
        }
      }
    }
  }
}
