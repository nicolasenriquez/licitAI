{
  "name": "twenty-e2e-testing",
  "projectType": "application",
  "tags": ["scope:testing"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": ["yarn playwright install", "cp .env.example .env"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": ["yarn playwright test"]
      }
    },
    "test:key-features": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "command": "yarn playwright test --config=playwright.key-features.standard.config.ts --project=chrome"
      }
    },
    "test:key-features:gated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "command": "yarn playwright test --config=playwright.key-features.config.ts"
      }
    },
    "test:external-integrations": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "command": "yarn playwright test --config=playwright.external-integrations.config.ts"
      }
    },
    "test:mercado-publico": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "command": "node scripts/run-mercado-publico-e2e.mjs all"
      },
      "configurations": {
        "warm": {
          "command": "node scripts/run-mercado-publico-e2e.mjs all --prepared --keep"
        }
      }
    },
    "test:mercado-publico:ui-contract": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
