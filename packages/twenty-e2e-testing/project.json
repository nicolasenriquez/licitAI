        "warm": {
          "command": "node scripts/run-mercado-publico-e2e.mjs ui-contract --prepared --keep"
        }
      }
    },
    "test:mercado-publico:journeys": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
