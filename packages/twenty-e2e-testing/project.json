      }
    },
    "test:mercado-publico:roles": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "command": "node scripts/run-mercado-publico-e2e.mjs roles"
      },
      "configurations": {
        "warm": {
          "command": "node scripts/run-mercado-publico-e2e.mjs roles --prepared --keep"
        }
      }
    },
    "test:mercado-publico:extended": {
