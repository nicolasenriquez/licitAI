        "$type": "dimension",
        "$value": "{primitives.spacing.1}",
        "$description": "Shared marketing spacing base unit."
      },
      "4": {
        "$type": "dimension",
        "$value": "{primitives.spacing.4}",
        "$description": "Shared marketing page gutter."
      }
    }
  },
  "dark": {
