{
  "$description": "marketing visual register generated from the canonical DTCG source.",
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "common": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "{primitives.typography.fontFamily.sans}",
