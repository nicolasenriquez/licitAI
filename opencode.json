{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "playwright-browser-worker": {
      "description": "Explore the application read-only using the repository-local Playwright CLI",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "external_directory": "deny",
        "e2e_status": "allow",
        "e2e_run": "allow",
        "e2e_prepare": "ask",
        "e2e_reset": "ask",
        "bash": {
          "*": "deny",
          "yarn --cwd packages/twenty-e2e-testing playwright cli": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright cli *": "allow"
        }
      }
    },
    "playwright-test-planner": {
      "description": "Explore the application and write Playwright plans",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "prompt": "{file:.opencode/prompts/playwright-test-planner.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": {
          "*": "deny",
          "specs/**": "allow"
        },
        "external_directory": "deny",
        "e2e_status": "allow",
        "e2e_run": "allow",
        "e2e_prepare": "ask",
        "e2e_reset": "ask",
        "bash": {
          "*": "deny",
          "yarn --cwd packages/twenty-e2e-testing playwright cli": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright cli *": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright test": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright test *": "allow"
        }
      }
    },
    "playwright-test-generator": {
      "description": "Generate Playwright tests from an approved plan",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "prompt": "{file:.opencode/prompts/playwright-test-generator.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": {
          "*": "deny",
          "packages/twenty-e2e-testing/**": "allow"
        },
        "external_directory": "deny",
        "e2e_status": "allow",
        "e2e_run": "allow",
        "e2e_prepare": "ask",
        "e2e_reset": "ask",
        "bash": {
          "*": "deny",
          "yarn --cwd packages/twenty-e2e-testing playwright cli": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright cli *": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright test": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright test *": "allow"
        }
      }
    },
    "playwright-test-healer": {
      "description": "Diagnose and repair Playwright tests within the E2E tree",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "prompt": "{file:.opencode/prompts/playwright-test-healer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": {
          "*": "deny",
          "packages/twenty-e2e-testing/**": "allow"
        },
        "external_directory": "deny",
        "e2e_status": "allow",
        "e2e_run": "allow",
        "e2e_prepare": "ask",
        "e2e_reset": "ask",
        "bash": {
          "*": "deny",
          "yarn --cwd packages/twenty-e2e-testing playwright cli": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright cli *": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright test": "allow",
          "yarn --cwd packages/twenty-e2e-testing playwright test *": "allow"
        }
      }
    }
  }
}
